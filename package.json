{
  "name": "itemlist",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo run check-types",
    "check-types": "turbo run check-types",
    "test:enforce": "node scripts/verify-tests.js",
    "test": "node scripts/verify-tests.js && turbo run check-types test"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/dagre": "^0.7.54",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.7",
    "typescript": "7.0.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.12.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-popover": "^1.3.0",
    "@radix-ui/react-select": "^2.4.0",
    "@radix-ui/react-tabs": "^1.2.0",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "lucide-react": "^1.55.0",
    "tailwind-merge": "^3.7.0"
  }
}
